# Defense-in-depth for a security testbed.
# This repo is NEVER meant to have dependencies installed. If someone runs `npm install`
# anyway, disabling install scripts prevents a malicious/typosquat package from executing
# arbitrary code during installation.
ignore-scripts=true

# Do not generate or update a lockfile (a committed lockfile is treated as an install
# artifact and rejected by the guardrail check).
package-lock=false
