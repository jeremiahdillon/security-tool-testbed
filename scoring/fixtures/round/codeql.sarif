{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {"id": "js/sql-injection", "properties": {"tags": ["security", "external/cwe/cwe-089"]}},
            {"id": "js/clear-text-logging", "properties": {"tags": ["security", "external/cwe/cwe-312"]}}
          ]
        }
      },
      "results": [
        {
          "ruleId": "js/sql-injection",
          "level": "error",
          "message": {"text": "This query depends on a user-provided value."},
          "locations": [
            {"physicalLocation": {"artifactLocation": {"uri": "cases/sast/js/demo/app.js"}, "region": {"startLine": 7}}}
          ]
        },
        {
          "ruleId": "js/clear-text-logging",
          "level": "warning",
          "message": {"text": "Potential clear-text logging (fixture false positive)."},
          "locations": [
            {"physicalLocation": {"artifactLocation": {"uri": "cases/sast/js/demo/app.js"}, "region": {"startLine": 3}}}
          ]
        }
      ]
    }
  ]
}
